#!/usr/bin/env bash
# Verdict agent installer — generated by {{ server_url }} for {{ user_email }}
# Generated at:  {{ generated_at }}
# Agent id:      {{ agent_id }}
# Hostname tag:  {{ hostname }}
#
# This script installs the Verdict collector agent into a per-user venv, writes
# its config (with your one-time API key baked in), and prints how to run it.
# Re-running this script will overwrite the config with the same values.

set -euo pipefail

SERVER_URL="{{ server_url }}"
API_KEY="{{ api_key }}"

INSTALL_ROOT="${IRS_AGENT_HOME:-$HOME/.local/share/irs-agent}"
VENV_DIR="$INSTALL_ROOT/venv"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/irs-agent"
CONFIG_FILE="$CONFIG_DIR/config.json"

say()  { printf '\033[1;34m[irs]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[irs] error:\033[0m %s\n' "$*" >&2; exit 1; }

# 1. Python
command -v python3 >/dev/null || die "python3 not found in PATH"
PYV=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
say "found python $PYV"
python3 -c 'import sys; sys.exit(0 if sys.version_info[:2] >= (3,9) else 1)' \
    || die "python >= 3.9 required (have $PYV)"

# 2. Venv
mkdir -p "$INSTALL_ROOT"
if [ ! -x "$VENV_DIR/bin/python" ]; then
    say "creating venv at $VENV_DIR"
    python3 -m venv "$VENV_DIR"
fi
"$VENV_DIR/bin/python" -m pip install --upgrade --quiet pip

# 3. Fetch the agent source from the server and install it
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT
TARBALL="$TMPDIR/irs-agent.tar.gz"
say "downloading agent source from $SERVER_URL"
if ! curl -fsSL --retry 3 -H "X-Agent-Key: $API_KEY" \
        -o "$TARBALL" "$SERVER_URL/ui/agent/source.tar.gz"; then
    die "failed to download agent source from $SERVER_URL/ui/agent/source.tar.gz"
fi

say "installing irs-agent into venv"
"$VENV_DIR/bin/pip" install --quiet --upgrade --force-reinstall --no-deps "$TARBALL"
"$VENV_DIR/bin/pip" install --quiet "$TARBALL"  # pull any new deps

# 4. Config
mkdir -p "$CONFIG_DIR"
umask 077
cat > "$CONFIG_FILE" <<JSON
{
  "server_url": "$SERVER_URL",
  "api_key": "$API_KEY",
  "verify_tls": true,
  "collectors": [
    {
      "name": "claude_code",
      "paths": [
        "$HOME/.claude/projects",
        "$HOME/claude-reports"
      ],
      "glob": "*.md"
    }
  ]
}
JSON
say "wrote config to $CONFIG_FILE"

# 4b. Install a Claude Code PostToolUse hook so reports written outside the
#     watched dirs (e.g. ~/reports/foo.md) still get uploaded automatically.
if [ -d "$HOME/.claude" ] || command -v claude >/dev/null 2>&1; then
    if "$VENV_DIR/bin/irs-agent" install-claude-hook; then
        :
    else
        printf '\033[1;33m[irs] warning:\033[0m failed to install Claude Code hook (continuing)\n' >&2
    fi
else
    say "skipping Claude Code hook (no ~/.claude dir and no 'claude' on PATH)"
fi

# 5. Register for boot persistence AND bring the agent up right now.
#    install-service auto-detects systemd/cron/launchd/schtasks and, under
#    systemd, writes the unit + `enable --now` + `loginctl enable-linger`
#    (so it survives logout). That already starts it immediately on systemd.
say "registering the agent to start on boot"
"$VENV_DIR/bin/irs-agent" install-service \
    || printf '\033[1;33m[irs] warning:\033[0m install-service failed (continuing)\n' >&2

# Was it actually started? systemd enable --now starts it now; boot-only
# methods (cron @reboot / launchd / schtasks) don't. If it isn't already
# running, launch the built-in background supervisor so it comes up without
# waiting for a reboot.
_agent_running() {
    command -v systemctl >/dev/null 2>&1 && {
        systemctl --user is-active --quiet irs-agent 2>/dev/null ||
        systemctl is-active --quiet irs-agent 2>/dev/null
    }
}
if _agent_running; then
    say "agent is running under systemd"
else
    say "starting the agent now"
    "$VENV_DIR/bin/irs-agent" start \
        || printf '\033[1;33m[irs] warning:\033[0m could not start the agent\n' >&2
fi

# 6. Offer to import pre-existing reports + POC files (interactive only)
if [ -t 0 ] && [ -t 1 ]; then
    printf '\n'
    printf '\033[1;36m[irs]\033[0m This machine may already have markdown reports or POC files\n'
    printf '      under ~/.claude/projects, ~/claude-reports, ~/my-reports, etc.\n'
    printf '      Want to scan + import them now? [Y/n] '
    read -r ans </dev/tty
    case "$ans" in
        ""|y|Y|yes|YES)
            "$VENV_DIR/bin/irs-agent" import || true
            ;;
        *)
            printf '      Skipped. You can run it later with:\n'
            printf '          %s/bin/irs-agent import\n' "$VENV_DIR"
            ;;
    esac
else
    printf 'To import pre-existing reports/POC files: %s/bin/irs-agent import\n' "$VENV_DIR"
fi

# 7. Next steps
printf '\n\033[1;32m[irs] install complete — the agent is starting up.\033[0m\n\n'

printf 'It should show as online in %s within a few seconds.\n' "$SERVER_URL"
printf 'Check it locally:\n'
printf '    %s/bin/irs-agent status\n' "$VENV_DIR"
printf '    systemctl --user status irs-agent      # if running under systemd\n'
printf '    journalctl --user -u irs-agent -f       # logs (systemd)\n\n'

printf 'Drop *.md reports under one of:\n'
printf '    %s/.claude/projects/\n' "$HOME"
printf '    %s/claude-reports/\n' "$HOME"
printf 'and they will appear in %s/ within a couple of seconds.\n\n' "$SERVER_URL"
