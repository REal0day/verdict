# ---- server ----
IRS_SECRET_KEY=change-me-32+chars-random
# 32-byte urlsafe base64 key for AES-GCM at-rest encryption.
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
IRS_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY
IRS_ACCESS_TOKEN_EXPIRE_MIN=720
IRS_DATABASE_URL=postgresql+psycopg://irs:irs@db:5432/irs

# initial admin bootstrap (created on first start if not present)
IRS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
IRS_BOOTSTRAP_ADMIN_PASSWORD=admin

# ---- self-service registration ----
# Public signup at /ui/register. Off by default. No email verification —
# the only gate is the domain allowlist below.
IRS_SIGNUP_ENABLED=0
# comma-separated allowed email domains for signup (case-insensitive, no @)
IRS_SIGNUP_ALLOWED_DOMAINS=example.com

# ---- AI providers (server-side) ----
IRS_DEFAULT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
XAI_API_KEY=
XAI_MODEL=grok-2
