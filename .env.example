# ---- server ----
IRS_SECRET_KEY=change-me-32+chars-random
# 32-byte urlsafe base64 key for AES-GCM at-rest encryption.
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
IRS_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY
IRS_ACCESS_TOKEN_EXPIRE_MIN=720
IRS_DATABASE_URL=postgresql+psycopg://irs:irs@db:5432/irs

# initial admin bootstrap (created on first start if not present)
IRS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
IRS_BOOTSTRAP_ADMIN_PASSWORD=admin

# ---- self-service registration ----
# Public signup at /ui/register. Off by default. No email verification —
# the only gate is the domain allowlist below.
IRS_SIGNUP_ENABLED=0
# comma-separated allowed email domains for signup (case-insensitive, no @)
IRS_SIGNUP_ALLOWED_DOMAINS=example.com

# ---- AI providers (server-side) ----
# Which provider the server uses: anthropic | openai | gemini | grok | local
# Can also be set (and persisted) from the admin portal under Settings -> AI.
IRS_DEFAULT_AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Override to use an OpenAI-compatible gateway (LiteLLM, OpenRouter, Azure).
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

XAI_API_KEY=
XAI_MODEL=grok-2
XAI_BASE_URL=https://api.x.ai/v1

# ---- local / self-hosted model (OpenAI-compatible) ----
# Works with Ollama, vLLM, LM Studio, llama.cpp, LocalAI, LiteLLM, OpenRouter.
#
#   Running on the SAME machine as this server:
#     LOCAL_AI_BASE_URL=http://localhost:11434/v1
#     The server rewrites loopback to host.docker.internal automatically when
#     it is containerised, so "localhost" means *your* machine, not the
#     container. Set IRS_LOCAL_AI_NO_REWRITE=1 to disable that.
#
#   Running on ANOTHER host:
#     LOCAL_AI_BASE_URL=http://gpu-box.lan:11434/v1
#
# A trailing /v1 is added if you leave it off. Most local servers ignore the
# API key; set it only if yours requires one (LiteLLM/OpenRouter do).
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
